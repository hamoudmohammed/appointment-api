# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Administrative Security (required for DELETE /appointments/:id)
# Set your private secret key here - do not share it publicly
ADMIN_API_KEY=your_secure_admin_api_key_here

# Storage Mode (set to 'true' to run without PostgreSQL in pure memory)
USE_IN_MEMORY=false

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=appointments_db
DB_SSL=false

# Or via complete connection string (e.g., AWS RDS / Neon / Supabase):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/appointments_db
