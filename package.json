    "nodejs",
    "rest-api",
    "clean-architecture",
    "backend"
  ],
  "author": "Mohammed Hamoud",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
