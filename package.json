{
  "name": "appointment-api",
  "version": "1.0.0",
  "description": "Production-ready REST API for appointment management built with TypeScript, Node.js, and clean architecture.",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
